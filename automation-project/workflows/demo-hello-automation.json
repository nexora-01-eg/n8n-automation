{
  "name": "Demo - Hello Automation",
  "id": "demo-hello-e2e-01",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "in1", "name": "name", "value": "Nour", "type": "string" },
            { "id": "in2", "name": "city", "value": "Cairo", "type": "string" },
            { "id": "in3", "name": "language", "value": "ar", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Set Input Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "try {\n  const out = [];\n  for (const item of $input.all()) {\n    const name = (item.json.name || 'Guest').toString().trim();\n    const city = (item.json.city || 'Unknown').toString().trim();\n    if (!name) throw new Error('empty name is not allowed');\n    const message = `Hello ${name} from ${city}! n8n local automation works.`;\n    console.log(`[demo-hello] processed name=${name} city=${city}`);\n    out.push({ json: { name, city, message, shouted: message.toUpperCase(), success: true } });\n  }\n  return out;\n} catch (err) {\n  console.log(`[demo-hello] ERROR: ${err.message}`);\n  return [{ json: { success: false, error: err.message } }];\n}"
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Build Greeting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "settings": { "onError": "continueRegularOutput" }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "o1", "name": "message", "value": "={{ $json.message }}", "type": "string" },
            { "id": "o2", "name": "success", "value": "={{ $json.success }}", "type": "boolean" },
            { "id": "o3", "name": "name", "value": "={{ $json.name }}", "type": "string" },
            { "id": "o4", "name": "city", "value": "={{ $json.city }}", "type": "string" },
            { "id": "o5", "name": "shouted", "value": "={{ $json.shouted }}", "type": "string" },
            { "id": "o6", "name": "processedAt", "value": "={{ $now }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Shape Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Set Input Fields", "type": "main", "index": 0 }]] },
    "Set Input Fields": { "main": [[{ "node": "Build Greeting", "type": "main", "index": 0 }]] },
    "Build Greeting": { "main": [[{ "node": "Shape Output", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
