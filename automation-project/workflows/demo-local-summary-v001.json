                                         "jsCode":  "try { console.log(\"[demo-local] generating sample items\"); return [{json:{title:\"Local AI model released\",link:\"https://local.test/n1\",body:\"A new local AI model was released today with agent support.\"}},{json:{title:\"Local AI model released\",link:\"https://local.test/n1\",body:\"Duplicate of the first item.\"}},{json:{title:\"Neighborhood football results\",link:\"https://local.test/n2\",body:\"Weekend football scores from the neighborhood league.\"}},{json:{title:\"Agents automate office work\",link:\"https://local.test/n3\",body:\"AI agents now handle office workflows and llm tasks.\"}}]; } catch (err) { console.log(\"[demo-local] ERROR step1: \" + err.message); return [{json:{success:false, error:err.message}}]; }"
                                     },
                      "id":  "116bf448-d751-41f9-85a4-bf7738eab56a",
                      "name":  "Step 1",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       460,
                                       300
                                   ],
                      "settings":  {
                                       "onError":  "continueRegularOutput"
                                   }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "try { const seen = new Set(); const out = []; for (const item of $input.all()) { const link = item.json.link || \"\"; if (seen.has(link)) { console.log(\"[demo-local] duplicate skipped: \" + link); continue; } seen.add(link); const text = ((item.json.title || \"\") + \" \" + (item.json.body || \"\")).toLowerCase(); let score = 0; let category = \"general\"; if (text.includes(\"ai\") || text.includes(\"llm\") || text.includes(\"agent\") || text.includes(\"model\")) { score += 2; category = \"ai\"; } if (text.includes(\"football\") || text.includes(\"league\")) { category = \"sports\"; } out.push({json:{title:item.json.title, link:link, category:category, important:(score \u003e= 2)}}); } console.log(\"[demo-local] kept \" + out.length + \" unique items\"); return out; } catch (err) { console.log(\"[demo-local] ERROR step2: \" + err.message); return [{json:{success:false, error:err.message}}]; }"
                                     },
                      "id":  "6caf6889-7468-4fec-bff2-c1bcb1714e3c",
                      "name":  "Step 2",
                      "type":  "n8n-nodes-base.code",
