                  {
                      "parameters":  {
                                         "jsCode":  "function cyrb53(str, seed) { seed = seed || 0; var h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed; for (var i = 0; i \u003c str.length; i++) { var ch = str.charCodeAt(i); h1 = Math.imul(h1 ^ ch, 2654435761); h2 = Math.imul(h2 ^ ch, 1597334677); } h1 = Math.imul(h1 ^ (h1 \u003e\u003e\u003e 16), 2246822507); h1 ^= Math.imul(h2 ^ (h2 \u003e\u003e\u003e 13), 3266489909); h2 = Math.imul(h2 ^ (h2 \u003e\u003e\u003e 16), 2246822507); h2 ^= Math.imul(h1 ^ (h1 \u003e\u003e\u003e 13), 3266489909); return ((h2 \u003e\u003e\u003e 0).toString(16) + (h1 \u003e\u003e\u003e 0).toString(16)); } try { var seen = {}; var out = []; var dups = 0; for (const item of $input.all()) { var j = item.json || {}; if (j._error) { out.push({ json: j }); continue; } var normTitle = String(j.title || \"\").toLowerCase().replace(/\\s+/g, \" \").replace(/[^a-z0-9 \\u0600-\\u06FF]/g, \"\").trim(); var normUrl = String(j.url || \"\").toLowerCase().split(\"?\")[0].split(\"#\")[0].replace(/\\/$/, \"\"); var fingerprint = cyrb53(normUrl + \"|\" + normTitle); if (seen[fingerprint]) { dups++; continue; } seen[fingerprint] = true; out.push({ json: { title: j.title, url: j.url, source: j.source, publishedAt: j.publishedAt, description: j.description, fingerprint: fingerprint } }); } console.log(\"[dedupe] unique=\" + out.filter(function(o){return !o.json._error;}).length + \" dups=\" + dups); return out; } catch (err) { console.log(\"[dedupe] FATAL: \" + err.message); return [{ json: { source: \"pipeline\", error: err.message, timestamp: new Date().toISOString(), _error: true } }]; }"
