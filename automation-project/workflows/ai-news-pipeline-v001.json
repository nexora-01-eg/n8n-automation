                                         "jsCode":  "try { var store = $getWorkflowStaticData(\"global\"); var items = []; for (const item of $input.all()) { if (item.json \u0026\u0026 !item.json._error) { items.push(item.json); } } var date = new Date().toISOString().slice(0, 10); store.newsDates = store.newsDates || {}; var day = store.newsDates[date] || { items: [] }; var known = {}; for (const e of day.items) { known[e.fingerprint] = true; } var added = 0; for (const it of items) { if (!known[it.fingerprint]) { known[it.fingerprint] = true; day.items.push(it); added++; } } store.newsDates[date] = day; console.log(\"[store] date=\" + date + \" added=\" + added + \" total=\" + day.items.length); return [{ json: { date: date, newItems: items.length, addedTotal: added, storedTotal: day.items.length, aiMode: \"AI_DISABLED\", runAt: new Date().toISOString() } }]; } catch (err) { console.log(\"[store] FATAL: \" + err.message); return [{ json: { source: \"pipeline\", error: err.message, timestamp: new Date().toISOString(), _error: true } }]; }"
