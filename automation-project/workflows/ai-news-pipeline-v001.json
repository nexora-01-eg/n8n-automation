                      "parameters":  {
                                         "jsCode":  "try {\n  const out = [];\n  const now = new Date().toISOString();\n  for (const item of $input.all()) {\n    const j = item.json || {};\n    var hostMap = { \"www.theguardian.com\": \"The Guardian AI\", \"www.technologyreview.com\": \"MIT Technology Review\" };\n    var rawUrl = String(j.link || j.url || j.guid || \"\");\n    var host = rawUrl.split(\"//\").length \u003e 1 ? rawUrl.split(\"//\")[1].split(\"/\")[0].toLowerCase() : \"\";\n    var srcName = (j.source \u0026\u0026 j.source !== \"unknown\") ? j.source : (hostMap[host] || host || \"unknown\");\n    if (j._error || j.error) {\n      const msg = (j.error \u0026\u0026 j.error.message) ? j.error.message : String(j.error || \u0027fetch failed\u0027);\n      console.log(\u0027[normalize] SOURCE ERROR source=\u0027 + (j.source || \u0027unknown\u0027) + \u0027 error=\u0027 + msg);\n      out.push({ json: { source: srcName, error: msg, timestamp: now, _error: true } });\n      continue;\n    }\n    const title = String(j.title || \u0027\u0027).trim();\n    const url = String(j.link || j.url || j.guid || \u0027\u0027).trim();\n    if (!title \u0026\u0026 !url) {\n      console.log(\u0027[normalize] MALFORMED item skipped (no title, no url)\u0027);\n      out.push({ json: { source: srcName, error: \u0027malformed: missing title and url\u0027, timestamp: now, _error: true } });\n      continue;\n    }\n    out.push({ json: {\n      title: title,\n      url: url,\n      source: srcName,\n      publishedAt: String(j.pubDate || j.published || j.updated || j.isoDate || \u0027\u0027),\n      description: String(j.description || j.contentSnippet || j.content || j.summary || \u0027\u0027).slice(0, 2000)\n    } });\n  }\n  console.log(\u0027[normalize] ok=\u0027 + out.filter(o =\u003e !o.json._error).length + \u0027 errors=\u0027 + out.filter(o =\u003e o.json._error).length);\n  return out;\n} catch (err) {\n  console.log(\u0027[normalize] FATAL: \u0027 + err.message);\n  return [{ json: { source: \u0027pipeline\u0027, error: err.message, timestamp: new Date().toISOString(), _error: true } }];\n}"
