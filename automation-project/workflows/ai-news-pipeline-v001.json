                      "parameters":  {
                                         "jsCode":  "try {\n  const RULES = [\n    { cat: \u0027AI Models\u0027, keys: [\u0027model\u0027, \u0027llm\u0027, \u0027gpt\u0027, \u0027claude\u0027, \u0027gemini\u0027, \u0027llama\u0027, \u0027checkpoint\u0027, \u0027weights\u0027, \u0027foundation model\u0027] },\n    { cat: \u0027AI Agents\u0027, keys: [\u0027agent\u0027, \u0027autonomous\u0027, \u0027mcp\u0027, \u0027tool use\u0027, \u0027workflow automation\u0027] },\n    { cat: \u0027Generative AI\u0027, keys: [\u0027image generator\u0027, \u0027video\u0027, \u0027diffusion\u0027, \u0027midjourney\u0027, \u0027sora\u0027, \u0027stable diffusion\u0027, \u0027generator\u0027] },\n    { cat: \u0027AI Coding\u0027, keys: [\u0027code\u0027, \u0027coding\u0027, \u0027copilot\u0027, \u0027cursor\u0027, \u0027programmer\u0027, \u0027developer\u0027, \u0027ide\u0027] },\n    { cat: \u0027Robotics\u0027, keys: [\u0027robot\u0027, \u0027humanoid\u0027, \u0027drone\u0027, \u0027embodied\u0027] },\n    { cat: \u0027AI Business\u0027, keys: [\u0027startup\u0027, \u0027funding\u0027, \u0027billion\u0027, \u0027million\u0027, \u0027market\u0027, \u0027stock\u0027, \u0027enterprise\u0027, \u0027revenue\u0027] },\n    { cat: \u0027Research\u0027, keys: [\u0027paper\u0027, \u0027arxiv\u0027, \u0027study\u0027, \u0027researchers\u0027, \u0027benchmark\u0027, \u0027dataset\u0027] },\n    { cat: \u0027Open Source\u0027, keys: [\u0027open source\u0027, \u0027github\u0027, \u0027hugging face\u0027, \u0027apache\u0027, \u0027mit license\u0027] },\n    { cat: \u0027Regulation\u0027, keys: [\u0027regulation\u0027, \u0027law\u0027, \u0027eu ai act\u0027, \u0027policy\u0027, \u0027copyright\u0027, \u0027safety\u0027, \u0027ban\u0027] }\n  ];\n  const out = [];\n  for (const item of $input.all()) {\n    const j = item.json || {};\n    if (j._error) { out.push({ json: j }); continue; }\n    const text = ((j.title || \u0027\u0027) + \u0027 \u0027 + (j.description || \u0027\u0027)).toLowerCase();\n    let best = { cat: \u0027Other\u0027, hits: 0 };\n    const topics = [];\n    for (const r of RULES) {\n      let hits = 0;\n      for (const k of r.keys) { if (text.includes(k)) { hits++; topics.push(k); } }\n      if (hits \u003e best.hits) { best = { cat: r.cat, hits: hits }; }\n    }\n    const importance = Math.min(100, 25 + best.hits * 15);\n    out.push({ json: { ...j, category: best.cat, importance: importance, topics: topics.slice(0, 5), classifier: \u0027rules-v001 (deterministic, NOT AI-powered)\u0027 } });\n  }\n  console.log(\u0027[classify] classified=\u0027 + out.length);\n  return out;\n} catch (err) {\n  console.log(\u0027[classify] FATAL: \u0027 + err.message);\n  return [{ json: { source: \u0027pipeline\u0027, error: err.message, timestamp: new Date().toISOString(), _error: true } }];\n}"
