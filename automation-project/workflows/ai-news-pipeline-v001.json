                  {
                      "parameters":  {
                                         "jsCode":  "try { var out = []; function clean(s) { s = String(s || \"\"); s = s.replace(/\u003c!\\[CDATA\\[([\\s\\S]*?)\\]\\]\u003e/g, \"$1\"); s = s.replace(/\u0026amp;/g, \"\u0026\").replace(/\u0026lt;/g, \"\u003c\").replace(/\u0026gt;/g, \"\u003e\").replace(/\u0026quot;/g, String.fromCharCode(34)).replace(/\u0026#39;/g, String.fromCharCode(39)); s = s.replace(/\u0026#(\\d+);/g, function(m, n) { return String.fromCharCode(parseInt(n, 10)); }); return s.trim(); } function field(block, tag) { var m = block.match(new RegExp(\"\u003c\" + tag + \"(?:\\\\s[^\u003e]*)?\u003e([\\\\s\\\\S]*?)\u003c\\\\/\" + tag + \"\u003e\", \"i\")); return m ? clean(m[1]) : \"\"; } for (const item of $input.all()) { var j = item.json || {}; if (j._error || j.error) { out.push({ json: j }); continue; } var xml = (typeof j.data === \"string\") ? j.data : \"\"; if (!xml) { console.log(\"[parse] no xml payload, skipping item\"); continue; } var blocks = xml.match(/\u003c(item|entry)(?:\\s[^\u003e]*)?\u003e([\\s\\S]*?)\u003c\\/\\1\u003e/gi) || []; console.log(\"[parse] blocks=\" + blocks.length); for (const b of blocks) { var link = field(b, \"link\") || field(b, \"guid\"); out.push({ json: { title: field(b, \"title\"), link: link, pubDate: field(b, \"pubDate\") || field(b, \"published\") || field(b, \"updated\"), description: (field(b, \"description\") || field(b, \"content:encoded\") || field(b, \"content\") || field(b, \"summary\")).slice(0, 2000), guid: field(b, \"guid\") } }); } } return out; } catch (err) { console.log(\"[parse] FATAL: \" + err.message); return [{ json: { source: \"pipeline\", error: err.message, timestamp: new Date().toISOString(), _error: true } }]; }"
